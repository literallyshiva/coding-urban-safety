rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Research prototype: unauthenticated participants may only create assessments.
    // Tighten these rules before any public production deployment.
    match /assessments/{assessmentId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'location',
          'safety_rating',
          'unsafe_conditions',
          'place_experience',
          'spend_more_time',
          'spatial_conditions',
          'ludic_qualities',
          'ludic_rating',
          'design_responses',
          'other_suggestion',
          'created_at'
        ]) &&
        request.resource.data.location is latlng &&
        request.resource.data.safety_rating is int &&
        request.resource.data.safety_rating >= 1 &&
        request.resource.data.safety_rating <= 5 &&
        request.resource.data.unsafe_conditions is list &&
        request.resource.data.place_experience is list &&
        request.resource.data.spend_more_time is string &&
        request.resource.data.spatial_conditions is list &&
        request.resource.data.ludic_qualities is list &&
        request.resource.data.ludic_rating is int &&
        request.resource.data.ludic_rating >= 1 &&
        request.resource.data.ludic_rating <= 5 &&
        request.resource.data.design_responses is list &&
        request.resource.data.other_suggestion is string &&
        request.resource.data.created_at == request.time;

      allow read, update, delete: if false;
    }
  }
}
